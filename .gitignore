# Python bytecode cache
__pycache__/
*.pyc

# Local Python virtual environment
litime/
venv/
.venv/

# Scratch / backup files (old copies, not part of the project)
other/

# Ad-hoc desktop screenshots dropped in the repo root (not the documented
# images/ folder used by the README)
/*.png

# Editor/OS cruft
.vscode/
*.swp
.DS_Store
venv/

# Local config with real credentials/keys — use config.ini.example as template
# (paste into http://<device>/config after first flash). Hardware-only
# config.h (pins/colors) IS tracked.
first-boot-config.ini

# Local launcher script (machine-specific, not part of the project)
start_litime

# Arduino IDE "Export Compiled Binary" output (build/ in the sketch root).
# The .bin/.elf/.map contain compiled-in WiFi/MQTT credentials and the
# Victron encryption key, and the rest is USB-flashing machinery (bootloader,
# partition table, merged factory image) — none of it belongs in git.
build/

# Ad-hoc pre-change backup copies of the dashboard script (e.g.
# litime_monitor.py.pre-pv-fill)
*.pre-*

# Local settings and secrets - never commit these. Copy the *.example files instead.
config.ini
dashboard_config.ini
first-boot-config.ini

# Compiled firmware images contain the WiFi/MQTT credentials and the Victron key
*.bin
*.elf
*.map
